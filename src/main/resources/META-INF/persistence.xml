<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.2"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd">

  <persistence-unit name="AudifonosPU" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

    <!-- Entidades JPA utilizadas en el modelo ORM -->
    <class>com.mycompany.crudaudifonos.entities.TbCategoria</class>
    <class>com.mycompany.crudaudifonos.entities.TbAudifono</class>
    <class>com.mycompany.crudaudifonos.entities.TbProveedor</class>
    <class>com.mycompany.crudaudifonos.entities.TbCliente</class>
    <class>com.mycompany.crudaudifonos.entities.TbMantenimiento</class>

    <properties>
      <!-- Configuración de conexión a PostgreSQL -->
      <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/bd_audifonos"/>
      <property name="jakarta.persistence.jdbc.user" value="postgres"/>
      <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
      <property name="jakarta.persistence.jdbc.password" value="1234"/>

      <!-- Configuración básica de Hibernate -->
      <property name="hibernate.cache.provider_class" value="org.hibernate.cache.NoCacheProvider"/>
    </properties>
  </persistence-unit>
</persistence>